:root {
    --main-white: rgb(209, 209, 209);
}

/* Anything a selection scope links: room at its left for the cursor, drawn there while it has focus. */
.rpg-selectable {
    flex-direction: row;
    min-height: 64px;
    padding-left: 72px;
    background-position-x: left;
    background-position-y: center;
    background-size: 64px 64px;
    background-repeat: no-repeat;
}

.rpg-selectable:focus {
    background-image: url("project://database/Packages/com.rpgframework.core/Runtime/UI/right.png?fileID=2800000&guid=5e7b180264754214a907ba761d020a48&type=3#right");
}

.rpg-ui-label {
    color: var(--main-white);
    text-shadow: 4px 3px 0 rgba(0, 0, 0, 0.27);
    -unity-text-align: middle-left;
}

.rpg-countdown {
    font-size: 60px;
}

.dialogue-window {
    background-color: rgb(68, 68, 68);
}

.dialogue-window--thought {
    background-color: rgba(68, 68, 68, 0.55);
}

.dialogue-window--transparent {
    background-color: rgba(0, 0, 0, 0);
}

.dialogue-window--fitted {
    padding: 12px 16px;
}
